<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Services — Flortran Advisory & Consulting</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --gold: #C49A2A;
      --gold-light: #E8C55A;
      --gold-muted: #A07E22;
      --navy: #0E1A2B;
      --navy-mid: #162338;
      --navy-light: #1E3050;
      --cream: #FAF7F2;
      --white: #FFFFFF;
      --text-dark: #0E1A2B;
      --text-mid: #3D4F66;
      --text-light: #6B7E96;
      --border: rgba(196,154,42,0.18);
      --shadow-gold: 0 8px 40px rgba(196,154,42,0.13);
      --shadow-navy: 0 8px 40px rgba(14,26,43,0.13);
      --font-display: 'Cormorant Garamond', serif;
      --font-body: 'DM Sans', sans-serif;
      --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    }

    html { scroll-behavior: smooth; }
    body {
      font-family: var(--font-body);
      background: var(--cream);
      color: var(--text-dark);
      overflow-x: hidden;
    }

    body::before {
      content: '';
      position: fixed; inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
      pointer-events: none; z-index: 9999; opacity: 0.4;
    }

    /* PROGRESS */
    #progress-bar {
      position: fixed; top: 0; left: 0; height: 2px;
      background: linear-gradient(90deg, var(--gold), var(--gold-light));
      z-index: 10000; width: 0%; transition: width 0.1s linear;
    }

    /* CURSOR */
    .cursor {
      position: fixed; width: 10px; height: 10px;
      background: var(--gold); border-radius: 50%;
      pointer-events: none; z-index: 9998;
      transform: translate(-50%,-50%);
    }
    .cursor-ring {
      position: fixed; width: 36px; height: 36px;
      border: 1.5px solid rgba(196,154,42,0.5); border-radius: 50%;
      pointer-events: none; z-index: 9997;
      transform: translate(-50%,-50%);
      transition: width 0.3s var(--ease-out), height 0.3s var(--ease-out);
    }

    /* NAV */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
      padding: 0 5%; display: flex; align-items: center;
      justify-content: space-between; height: 72px;
      background: rgba(250,247,242,0.85);
      backdrop-filter: blur(18px) saturate(1.4);
      border-bottom: 1px solid var(--border);
      transition: box-shadow 0.3s, background 0.3s;
    }
    nav.scrolled { box-shadow: 0 4px 32px rgba(14,26,43,0.08); background: rgba(250,247,242,0.97); }
    .nav-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
    .logo-name { font-family: var(--font-display); font-size: 1.35rem; font-weight: 700; color: var(--navy); letter-spacing: 0.06em; }
    .logo-tagline { font-size: 0.55rem; letter-spacing: 0.22em; color: var(--gold); text-transform: uppercase; font-weight: 500; margin-top: 2px; }
    .nav-links { display: flex; align-items: center; gap: 2.2rem; list-style: none; }
    .nav-links a {
      text-decoration: none; font-size: 0.875rem; font-weight: 450;
      color: var(--text-mid); position: relative; transition: color 0.2s;
    }
    .nav-links a::after {
      content: ''; position: absolute; bottom: -3px; left: 0;
      width: 0; height: 1.5px; background: var(--gold);
      transition: width 0.25s var(--ease-out);
    }
    .nav-links a:hover { color: var(--navy); }
    .nav-links a:hover::after, .nav-links a.active::after { width: 100%; }
    .nav-links a.active { color: var(--navy); }
    .btn-cta {
      background: var(--gold); color: var(--white); border: none;
      border-radius: 4px; padding: 10px 22px;
      font-family: var(--font-body); font-size: 0.875rem; font-weight: 600;
      letter-spacing: 0.02em; cursor: pointer;
      transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
      text-decoration: none; display: inline-block;
    }
    .btn-cta:hover { background: var(--gold-muted); transform: translateY(-1px); box-shadow: 0 6px 24px rgba(196,154,42,0.35); }

    /* HERO */
    .services-hero {
      min-height: 72vh;
      padding: 120px 5% 80px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
      position: relative;
      overflow: hidden;
      background: var(--cream);
    }
    .services-hero::after {
      content: ''; position: absolute; bottom: 0; left: 0;
      width: 100%; height: 1px;
      background: linear-gradient(90deg, transparent, var(--border), transparent);
    }

    /* Geometric 3D shape */
    .hero-shape {
      position: relative; display: flex; align-items: center; justify-content: center;
      opacity: 0; animation: fadeIn 1.2s var(--ease-out) 0.3s forwards;
    }
    .shape-svg { width: 100%; max-width: 380px; filter: drop-shadow(0 24px 48px rgba(14,26,43,0.1)); }

    .hero-eyebrow {
      display: flex; align-items: center; gap: 10px;
      font-size: 0.72rem; font-weight: 600; letter-spacing: 0.25em;
      text-transform: uppercase; color: var(--gold); margin-bottom: 1.4rem;
      opacity: 0; animation: fadeUp 0.8s var(--ease-out) 0.2s forwards;
    }
    .hero-eyebrow::after { content: ''; flex: 1; max-width: 48px; height: 1px; background: var(--gold); }

    .hero-headline {
      font-family: var(--font-display);
      font-size: clamp(2.6rem, 5vw, 4.2rem);
      font-weight: 600; line-height: 1.08; color: var(--navy);
      margin-bottom: 1.5rem;
      opacity: 0; animation: fadeUp 0.9s var(--ease-out) 0.35s forwards;
    }
    .hero-sub {
      font-size: 1rem; line-height: 1.75; color: var(--text-mid);
      max-width: 460px; font-weight: 300;
      opacity: 0; animation: fadeUp 0.9s var(--ease-out) 0.5s forwards;
    }

    /* SERVICE CARDS ROW */
    .service-cards-section { padding: 80px 5%; background: var(--white); }
    .service-cards-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;
    }
    .service-card {
      background: var(--cream); border: 1px solid rgba(14,26,43,0.07);
      border-radius: 10px; padding: 32px 28px;
      transition: transform 0.3s var(--ease-out), box-shadow 0.3s, border-color 0.3s;
      position: relative; overflow: hidden;
    }
    .service-card::before {
      content: ''; position: absolute; bottom: 0; left: 0; right: 0;
      height: 2px; background: linear-gradient(90deg, var(--gold), var(--gold-light));
      transform: scaleX(0); transform-origin: left;
      transition: transform 0.35s var(--ease-out);
    }
    .service-card:hover { transform: translateY(-5px); box-shadow: 0 20px 60px rgba(14,26,43,0.1); border-color: rgba(196,154,42,0.2); }
    .service-card:hover::before { transform: scaleX(1); }
    .service-icon {
      width: 52px; height: 52px; border: 1.5px solid var(--border);
      border-radius: 10px; display: flex; align-items: center; justify-content: center;
      color: var(--gold); margin-bottom: 18px;
      transition: background 0.2s, border-color 0.2s;
    }
    .service-card:hover .service-icon { background: rgba(196,154,42,0.08); border-color: var(--gold); }
    .service-icon svg { width: 24px; }
    .service-card h3 { font-family: var(--font-display); font-size: 1.2rem; font-weight: 600; color: var(--navy); margin-bottom: 10px; }
    .service-card p { font-size: 0.84rem; line-height: 1.72; color: var(--text-light); margin-bottom: 20px; }
    .learn-more {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 0.8rem; font-weight: 600; color: var(--gold);
      text-decoration: none; transition: gap 0.2s;
    }
    .learn-more:hover { gap: 10px; }

    /* COMPARISON TABLE */
    .comparison-section { padding: 80px 5%; background: var(--cream); }
    .section-label {
      display: flex; align-items: center; gap: 14px;
      margin-bottom: 32px;
    }
    .section-label::before { content: ''; width: 36px; height: 2px; background: var(--gold); }
    .section-label h2 {
      font-family: var(--font-display); font-size: clamp(1.6rem, 2.8vw, 2.2rem);
      font-weight: 600; color: var(--navy);
    }

    .comparison-table {
      width: 100%; border-collapse: collapse;
      background: var(--white); border-radius: 12px;
      overflow: hidden; box-shadow: 0 4px 32px rgba(14,26,43,0.07);
    }
    .comparison-table thead tr {
      background: var(--navy);
    }
    .comparison-table thead th {
      padding: 18px 20px; text-align: left;
      font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase;
      font-weight: 600; color: rgba(255,255,255,0.7);
    }
    .comparison-table thead th:first-child { color: rgba(255,255,255,0.5); }
    .comparison-table thead th:not(:first-child) { text-align: center; }

    .comparison-table tbody tr {
      border-bottom: 1px solid rgba(14,26,43,0.05);
      transition: background 0.15s;
    }
    .comparison-table tbody tr:last-child { border-bottom: none; }
    .comparison-table tbody tr:hover { background: rgba(196,154,42,0.03); }

    .comparison-table tbody td {
      padding: 14px 20px; font-size: 0.84rem; color: var(--text-mid);
      vertical-align: middle;
    }
    .comparison-table tbody td:not(:first-child) { text-align: center; }

    .feature-cell {
      display: flex; align-items: center; gap: 10px;
    }
    .feature-cell-icon { color: var(--gold); opacity: 0.7; }
    .feature-cell-icon svg { width: 14px; }

    .check-icon { color: var(--gold); }
    .check-icon svg { width: 18px; }
    .timeline-text { font-size: 0.82rem; color: var(--text-mid); font-weight: 500; }
    .optional-text { font-size: 0.75rem; color: var(--text-light); font-style: italic; }

    .table-footer-row td {
      padding: 20px; background: rgba(14,26,43,0.02);
      border-top: 1px solid rgba(14,26,43,0.07) !important;
    }
    .table-footer-row td:not(:first-child) { text-align: center; }
    .btn-navy {
      display: inline-flex; align-items: center; gap: 8px;
      background: var(--navy); color: var(--white);
      border: none; border-radius: 5px; padding: 11px 22px;
      font-family: var(--font-body); font-size: 0.84rem; font-weight: 600;
      cursor: pointer; text-decoration: none;
      transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
    }
    .btn-navy:hover { background: var(--navy-light); transform: translateY(-1px); box-shadow: 0 6px 20px rgba(14,26,43,0.2); }
    .btn-navy svg { width: 14px; }

    /* WHO THIS IS FOR */
    .audience-section { padding: 80px 5%; background: var(--white); }
    .audience-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 40px; }
    .audience-card {
      padding: 32px 28px; border: 1px solid rgba(14,26,43,0.07);
      border-radius: 10px; background: var(--cream);
      transition: transform 0.3s var(--ease-out), box-shadow 0.3s;
    }
    .audience-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-navy); }
    .audience-avatar {
      width: 56px; height: 56px; border: 1.5px solid var(--border);
      border-radius: 50%; display: flex; align-items: center; justify-content: center;
      color: var(--gold); margin-bottom: 18px;
      transition: border-color 0.2s, background 0.2s;
    }
    .audience-card:hover .audience-avatar { border-color: var(--gold); background: rgba(196,154,42,0.07); }
    .audience-avatar svg { width: 24px; }
    .audience-card h3 { font-family: var(--font-display); font-size: 1.3rem; font-weight: 600; color: var(--navy); margin-bottom: 10px; }
    .audience-card p { font-size: 0.84rem; line-height: 1.72; color: var(--text-light); }

    /* CTA STRIP */
    .cta-strip {
      background: var(--navy); padding: 72px 5%;
      display: grid; grid-template-columns: auto 1fr auto;
      gap: 2rem; align-items: center;
      position: relative; overflow: hidden;
    }
    .cta-strip::before {
      content: ''; position: absolute; right: -5%; top: -80%;
      width: 400px; height: 400px;
      background: radial-gradient(circle, rgba(196,154,42,0.1) 0%, transparent 65%);
      pointer-events: none;
    }
    /* X pattern */
    .cta-strip::after {
      content: ''; position: absolute; inset: 0;
      background-image: repeating-linear-gradient(45deg, rgba(255,255,255,0.015) 0px, rgba(255,255,255,0.015) 1px, transparent 1px, transparent 40px),
                        repeating-linear-gradient(-45deg, rgba(255,255,255,0.015) 0px, rgba(255,255,255,0.015) 1px, transparent 1px, transparent 40px);
      pointer-events: none;
    }
    .cta-logo-icon { position: relative; z-index: 1; }
    .cta-logo-icon svg { width: 48px; opacity: 0.9; }
    .cta-text { position: relative; z-index: 1; }
    .cta-text h2 {
      font-family: var(--font-display); font-size: clamp(1.4rem, 2.5vw, 2rem);
      font-weight: 600; color: var(--white); margin-bottom: 6px;
    }
    .cta-text p { font-size: 0.88rem; color: rgba(255,255,255,0.55); line-height: 1.6; font-weight: 300; }
    .cta-action { position: relative; z-index: 1; }

    /* FOOTER */
    footer {
      background: var(--navy);
      border-top: 1px solid rgba(255,255,255,0.06);
      padding: 60px 5% 32px;
    }
    .footer-grid {
      display: grid; grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
      gap: 3rem; margin-bottom: 48px;
    }
    .footer-brand p {
      font-size: 0.82rem; line-height: 1.75;
      color: rgba(255,255,255,0.45); margin: 18px 0 22px; max-width: 240px;
    }
    .footer-socials { display: flex; gap: 12px; }
    .footer-socials a {
      width: 34px; height: 34px; border: 1px solid rgba(255,255,255,0.12);
      border-radius: 6px; display: flex; align-items: center; justify-content: center;
      color: rgba(255,255,255,0.5); transition: border-color 0.2s, color 0.2s;
    }
    .footer-socials a:hover { border-color: var(--gold); color: var(--gold); }
    .footer-socials svg { width: 15px; }
    .footer-col h4 {
      font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase;
      color: var(--gold); font-weight: 600; margin-bottom: 20px;
    }
    .footer-col ul { list-style: none; }
    .footer-col ul li { margin-bottom: 10px; }
    .footer-col ul a {
      text-decoration: none; font-size: 0.84rem;
      color: rgba(255,255,255,0.5); transition: color 0.2s;
      display: flex; align-items: center; justify-content: space-between;
    }
    .footer-col ul a:hover { color: var(--white); }
    .footer-col ul a svg { width: 12px; opacity: 0.4; }
    .footer-connect p { font-size: 0.84rem; color: rgba(255,255,255,0.5); line-height: 1.6; margin-bottom: 18px; }
    .footer-bottom {
      border-top: 1px solid rgba(255,255,255,0.07); padding-top: 24px;
      display: flex; align-items: center; justify-content: space-between;
    }
    .footer-bottom p { font-size: 0.75rem; color: rgba(255,255,255,0.3); }
    .footer-bottom-links { display: flex; gap: 24px; }
    .footer-bottom-links a {
      font-size: 0.75rem; color: rgba(255,255,255,0.3);
      text-decoration: none; transition: color 0.2s;
    }
    .footer-bottom-links a:hover { color: rgba(255,255,255,0.7); }

    /* ANIMATIONS */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeIn {
      from { opacity: 0; } to { opacity: 1; }
    }
    @keyframes floatY {
      0%, 100% { transform: translateY(0); }
      50%       { transform: translateY(-14px); }
    }
    .float-anim { animation: floatY 5s ease-in-out infinite; }

    .reveal {
      opacity: 0; transform: translateY(28px);
      transition: opacity 0.7s var(--ease-out), transform 0.7s var(--ease-out);
    }
    .reveal.visible { opacity: 1; transform: translateY(0); }
    .reveal-delay-1 { transition-delay: 0.1s; }
    .reveal-delay-2 { transition-delay: 0.2s; }
    .reveal-delay-3 { transition-delay: 0.3s; }

    @media (max-width: 900px) {
      .services-hero { grid-template-columns: 1fr; padding-top: 110px; }
      .hero-shape { display: none; }
      .service-cards-grid, .audience-grid { grid-template-columns: 1fr; }
      .comparison-table thead th:nth-child(3),
      .comparison-table tbody td:nth-child(3),
      .comparison-table thead th:nth-child(4),
      .comparison-table tbody td:nth-child(4) { display: none; }
      .footer-grid { grid-template-columns: 1fr 1fr; gap: 2rem; }
      .cta-strip { grid-template-columns: 1fr; text-align: center; }
      .cta-logo-icon { display: none; }
      .footer-bottom { flex-direction: column; gap: 12px; }
      .nav-links, .btn-cta { display: none; }
    }
  </style>
</head>
