<!-- HERO -->
<section class="services-hero">
  <div>
    <div class="hero-eyebrow">Our Services</div>
    <h1 class="hero-headline">Focused financial work for serious capital conversations.</h1>
    <p class="hero-sub">Flortran delivers the financial clarity and strategic insight you need to make confident decisions, attract the right partners, and unlock meaningful value.</p>
  </div>
  <div class="hero-shape">
    <svg class="shape-svg float-anim" viewBox="0 0 380 340" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- 3D geometric shape inspired by the design -->
      <defs>
        <linearGradient id="faceTop" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#F5EDD6" stop-opacity="0.95"/>
          <stop offset="100%" stop-color="#E8D5A8" stop-opacity="0.8"/>
        </linearGradient>
        <linearGradient id="faceLeft" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#D4B97A" stop-opacity="0.6"/>
          <stop offset="100%" stop-color="#C49A2A" stop-opacity="0.3"/>
        </linearGradient>
        <linearGradient id="faceRight" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#F0E4C0" stop-opacity="0.5"/>
          <stop offset="100%" stop-color="#FAF7F2" stop-opacity="0.9"/>
        </linearGradient>
        <linearGradient id="barGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#C49A2A" stop-opacity="0.8"/>
          <stop offset="100%" stop-color="#0E1A2B" stop-opacity="0.9"/>
        </linearGradient>
      </defs>

      <!-- Main geometric block - left -->
      <g transform="translate(40,60)">
        <!-- Top face -->
        <polygon points="0,60 60,20 140,20 80,60" fill="url(#faceTop)" stroke="rgba(196,154,42,0.3)" stroke-width="0.5"/>
        <!-- Left face -->
        <polygon points="0,60 0,180 80,180 80,60" fill="url(#faceLeft)" stroke="rgba(196,154,42,0.2)" stroke-width="0.5"/>
        <!-- Right face -->
        <polygon points="80,60 80,180 160,180 140,20 140,20" fill="url(#faceRight)" stroke="rgba(255,255,255,0.4)" stroke-width="0.5"/>
        <!-- Edge highlight -->
        <line x1="80" y1="60" x2="80" y2="180" stroke="rgba(196,154,42,0.6)" stroke-width="1"/>
        <line x1="0" y1="60" x2="60" y2="20" stroke="rgba(196,154,42,0.4)" stroke-width="0.5"/>
      </g>

      <!-- Second block overlapping -->
      <g transform="translate(160,20)">
        <polygon points="0,80 70,30 150,30 80,80" fill="url(#faceTop)" stroke="rgba(196,154,42,0.25)" stroke-width="0.5" opacity="0.85"/>
        <polygon points="0,80 0,200 80,200 80,80" fill="url(#faceLeft)" stroke="rgba(196,154,42,0.15)" stroke-width="0.5" opacity="0.7"/>
        <polygon points="80,80 80,200 160,200 150,30" fill="url(#faceRight)" stroke="rgba(255,255,255,0.3)" stroke-width="0.5" opacity="0.8"/>
        <line x1="80" y1="80" x2="80" y2="200" stroke="rgba(196,154,42,0.5)" stroke-width="0.8"/>
